@page
@model GoogleBooksApp.Pages.BooksModel
@{
    ViewData["Title"] = "Book Search";

    var errorMessage = Model.ErrorMessage;
    var pageIndex = Model.PageIndex;
    var totalItems = Model.TotalItems;
    var hasNextPage = Model.HasNextPage;
    var hasPreviousPage = Model.HasPreviousPage;

    var hasSearchTerms = !string.IsNullOrWhiteSpace(Model.TitleQuery) || !string.IsNullOrWhiteSpace(Model.AuthorQuery);
    var searchPerformed = hasSearchTerms
        || !string.IsNullOrWhiteSpace(errorMessage)
        || totalItems > 0
        || pageIndex > 0
        || Request.Query.ContainsKey("pageIndex");
    var hasResults = Model.Results.Count > 0;
}

<style>
    .books-page {
        display: grid;
        gap: 1.5rem;
    }

    .search-form {
        display: grid;
        gap: 1rem;
        padding: 1rem;
        border: 1px solid #d0d7de;
        border-radius: 0.75rem;
        background: #f8fafc;
    }

    .search-form__fields {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .search-form__field {
        display: grid;
        gap: 0.35rem;
    }

    .search-form__field input {
        width: 100%;
        padding: 0.65rem 0.75rem;
        border: 1px solid #cbd5e1;
        border-radius: 0.5rem;
    }

    .search-form__actions {
        display: flex;
        justify-content: flex-start;
    }

    .search-form__actions button {
        padding: 0.7rem 1.2rem;
        border: 0;
        border-radius: 0.5rem;
        background: #2563eb;
        color: #fff;
        font-weight: 600;
        cursor: pointer;
    }

    .status-message {
        padding: 1rem;
        border-radius: 0.75rem;
        background: #eff6ff;
        color: #1e3a8a;
    }

    .status-message--error {
        background: #fef2f2;
        color: #991b1b;
    }

    .results-summary {
        color: #475569;
    }

    .results-grid {
        display: grid;
        gap: 1rem;
        padding: 0;
        margin: 0;
        list-style: none;
    }

    .result-card article {
        display: grid;
        gap: 1rem;
        grid-template-columns: minmax(96px, 128px) 1fr;
        padding: 1rem;
        border: 1px solid #d0d7de;
        border-radius: 0.75rem;
        background: #fff;
    }

    .book-cover {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 160px;
        padding: 0.5rem;
        border-radius: 0.5rem;
        background: #f1f5f9;
        overflow: hidden;
    }

    .book-cover img {
        max-width: 100%;
        max-height: 180px;
        object-fit: contain;
        display: block;
    }

    .book-cover__placeholder {
        display: none;
        align-items: center;
        justify-content: center;
        height: 100%;
        width: 100%;
        text-align: center;
        color: #64748b;
        font-size: 0.95rem;
    }

    .book-cover.is-fallback .book-cover__placeholder {
        display: flex;
    }

    .result-card__body {
        display: grid;
        gap: 0.6rem;
    }

    .result-card__body h2,
    .result-card__body p {
        margin: 0;
    }

    .result-card__authors {
        color: #475569;
        font-weight: 600;
    }

    .result-card__description {
        color: #334155;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 4;
        overflow: hidden;
    }

    .result-card__link a {
        color: #1d4ed8;
        font-weight: 600;
    }

    .pagination {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 0.5rem;
    }

    .pagination__actions {
        display: flex;
        gap: 0.75rem;
    }

    .pagination__link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 6.5rem;
        padding: 0.65rem 1rem;
        border: 1px solid #cbd5e1;
        border-radius: 999px;
        text-decoration: none;
        color: #0f172a;
        background: #fff;
    }

    .pagination__link--disabled {
        color: #94a3b8;
        background: #f8fafc;
    }

    @@media (max-width: 640px) {
        .result-card article {
            grid-template-columns: 1fr;
        }

        .book-cover {
            max-width: 180px;
        }
    }
</style>

<section class="books-page">
    <header>
        <h1>Book Search</h1>
        <p>Find titles, explore authors, and jump straight to the matching Google Books entry.</p>
    </header>

    <form method="post" class="search-form">
        <div class="search-form__fields">
            <div class="search-form__field">
                <label asp-for="TitleQuery"></label>
                <input asp-for="TitleQuery" autocomplete="off" placeholder="Search by title" />
            </div>
            <div class="search-form__field">
                <label asp-for="AuthorQuery"></label>
                <input asp-for="AuthorQuery" autocomplete="off" placeholder="Optional author name" />
            </div>
        </div>
        <div class="search-form__actions">
            <button type="submit">Search</button>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="status-message status-message--error" role="status">
            @errorMessage
        </div>
    }
    else if (!hasResults && searchPerformed)
    {
        <div class="status-message" role="status">
            No results found for your search.
        </div>
    }

    @if (hasResults)
    {
        <div class="results-summary" aria-live="polite">
            <p>
                Showing page @(pageIndex + 1)
                @if (totalItems > 0)
                {
                    <span>&middot; @totalItems result@(totalItems == 1 ? string.Empty : "s") found</span>
                }
            </p>
        </div>

        <ul class="results-grid">
            @foreach (var item in Model.Results)
            {
                var volumeInfo = item.VolumeInfo;
                var title = string.IsNullOrWhiteSpace(volumeInfo?.Title) ? "Untitled book" : volumeInfo.Title;
                var authors = volumeInfo?.Authors ?? Array.Empty<string>();
                var authorsText = authors.Count > 0 ? string.Join(", ", authors) : "Unknown author";
                var descriptionText = string.IsNullOrWhiteSpace(volumeInfo?.Description) ? "No description available." : volumeInfo.Description;
                var thumbnailUrl = volumeInfo?.ImageLinks?.Thumbnail ?? volumeInfo?.ImageLinks?.SmallThumbnail;
                var coverClass = string.IsNullOrWhiteSpace(thumbnailUrl) ? "book-cover is-fallback" : "book-cover";
                var previewUrl = $"https://books.google.com/books?id={Uri.EscapeDataString(item.Id)}";

                <li class="result-card">
                    <article>
                        <div class="@coverClass">
                            @if (!string.IsNullOrWhiteSpace(thumbnailUrl))
                            {
                                <img src="@thumbnailUrl"
                                     alt="Cover for @title"
                                     loading="lazy"
                                     referrerpolicy="no-referrer"
                                     onerror="this.closest('.book-cover').classList.add('is-fallback'); this.remove();" />
                            }
                            <span class="book-cover__placeholder">No cover available</span>
                        </div>
                        <div class="result-card__body">
                            <h2>@title</h2>
                            <p class="result-card__authors">@authorsText</p>
                            <p class="result-card__description">@descriptionText</p>
                            <p class="result-card__link">
                                <a href="@previewUrl" target="_blank" rel="noopener noreferrer">View on Google Books</a>
                            </p>
                        </div>
                    </article>
                </li>
            }
        </ul>
    }

    @if (hasResults || hasPreviousPage || hasNextPage)
    {
        <nav class="pagination" aria-label="Search results pages">
            <span>Showing page @(pageIndex + 1)</span>
            <div class="pagination__actions">
                @if (hasPreviousPage)
                {
                    <a asp-page="/Books"
                       asp-route-pageIndex="@(pageIndex - 1)"
                       asp-route-titleQuery="@Model.TitleQuery"
                       asp-route-authorQuery="@Model.AuthorQuery"
                       class="pagination__link">Previous</a>
                }
                else
                {
                    <span class="pagination__link pagination__link--disabled" aria-disabled="true">Previous</span>
                }

                @if (hasNextPage)
                {
                    <a asp-page="/Books"
                       asp-route-pageIndex="@(pageIndex + 1)"
                       asp-route-titleQuery="@Model.TitleQuery"
                       asp-route-authorQuery="@Model.AuthorQuery"
                       class="pagination__link">Next</a>
                }
                else
                {
                    <span class="pagination__link pagination__link--disabled" aria-disabled="true">Next</span>
                }
            </div>
        </nav>
    }
</section>
