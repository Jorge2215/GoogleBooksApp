<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GoogleBooksApp</title>
    <script>
        // Apply theme immediately to avoid flash
        (function() {
            var savedTheme = localStorage.getItem('theme');
            if (savedTheme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GoogleBooksApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light site-nav mb-4">
            <div class="container">
                <a class="navbar-brand site-brand" asp-area="" asp-page="/Books">GoogleBooksApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link site-nav__link" asp-area="" asp-page="/Books">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link site-nav__link" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link site-nav__link border-0 bg-transparent" data-bs-toggle="modal" data-bs-target="#aboutModal">About</button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link site-nav__link border-0 bg-transparent" id="themeToggle" aria-label="Toggle dark mode">
                                <span id="themeIcon">🌙</span>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-container">
        <main role="main" class="site-main pb-4">
            <div class="app-surface">
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            &copy; 2026 - GoogleBooksApp - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <div class="modal fade" id="aboutModal" tabindex="-1" aria-labelledby="aboutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content about-modal">
                <div class="modal-header about-modal__header">
                    <h2 class="modal-title fs-5" id="aboutModalLabel">About</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body about-modal__body">
                    <p>Sample Web App developed by SQUAD Windup Bird Team</p>
                    <p class="about-modal__version">Version 1.0.4 - Still under development but getting better everyday</p>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
